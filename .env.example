# Puerto HTTP del proceso; en AWS respetar el valor configurado por el entorno.
PORT=3000
# Selecciona el modo de ejecución y el formato de logs.
NODE_ENV=development
# Clave privada para firmar JWT; reemplazar por un secreto propio en producción.
JWT_SECRET=change-this-secret-in-production
# Duración de la sesión emitida al iniciar sesión.
JWT_EXPIRES_IN=2h

# Host de MySQL: endpoint de RDS en AWS o dirección accesible en desarrollo.
DB_HOST=
# Puerto TCP en el que MySQL acepta conexiones.
DB_PORT=3306
# Base existente donde el backend creará las tablas.
DB_NAME=taskflow
# Usuario con permisos para las consultas y creación inicial de tablas.
DB_USER=
# Contraseña de ese usuario; mantenerla fuera de Git.
DB_PASSWORD=
# Activa TLS con validación de certificado cuando el servidor esté configurado para ello.
DB_SSL=false
# Máximo de conexiones simultáneas del pool de este proceso.
DB_CONNECTION_LIMIT=10

# Nombre del usuario inicial; solo se crea si la tabla users está vacía.
TASKFLOW_ADMIN_NAME=Demo User
# Correo utilizado para iniciar sesión con ese usuario inicial.
TASKFLOW_ADMIN_EMAIL=demo@taskflow.local
# Contraseña inicial de demostración; reemplazar para el despliegue público.
TASKFLOW_ADMIN_PASSWORD=TaskFlow123
