# Configura la comprobación HTTP que Elastic Beanstalk realiza sobre la aplicación.
option_settings:
  - namespace: aws:elasticbeanstalk:application
    # Este nombre corresponde al health check clásico reconocido por Beanstalk.
    option_name: Application Healthcheck URL
    # Comprueba Express sin depender de que RDS esté disponible durante el arranque.
    value: /api/health
